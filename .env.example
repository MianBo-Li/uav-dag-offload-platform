APP_NAME=uav-dag-offload-platform
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/uav_dag
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=uav_dag_execution
EXECUTION_AUTO_ENQUEUE_ENABLED=false
SIMULATED_EXECUTION_DURATION_MS=100
SIMULATED_EXECUTION_SLEEP_SECONDS=0
HEARTBEAT_TIMEOUT_SECONDS=30
DEFAULT_SCHEDULER_STRATEGY=greedy
